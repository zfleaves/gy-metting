# ============================================================
# AI 智能会议纪要轻量化中台 — 环境变量配置
# 基于 DESIGN.md V1.1
# 复制此文件为 .env 并填入实际值
# ============================================================

# ----------------------------------------------------------
# 1. 服务基础配置（DESIGN.md §7.1 部署方案）
# ----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ----------------------------------------------------------
# 2. LLM 大模型配置（DESIGN.md §3.3.1 LLM 适配器）
# 支持 OpenAI 兼容模式，可切换 DeepSeek / 通义千问 / GLM
# ----------------------------------------------------------
# 提供商: deepseek | qwen | glm | openai | custom
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-llm-proxy.example.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-v4-flash
# 默认推理参数（可在界面/API 调用时覆盖）
LLM_DEFAULT_TEMPERATURE=0.3
LLM_DEFAULT_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# 指数退避重试（§9 风险应对）
LLM_MAX_RETRIES=3

# 备用模型（可选，切换模型时使用）
# LLM_PROVIDER_ALT=qwen
# LLM_BASE_URL_ALT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY_ALT=sk-your-qwen-api-key
# LLM_MODEL_ALT=qwen-plus

# ----------------------------------------------------------
# 3. ASR 语音转写配置（DESIGN.md §3.1.1 ASR 引擎方案对比）
# ----------------------------------------------------------
# 引擎: faster_whisper（主选，本地离线）| qwen3_asr_flash（备选，云端）
ASR_ENGINE=faster_whisper
# --- Faster-Whisper 参数 ---
# 模型大小: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
# 计算类型: int8（CPU 推荐）| float16（GPU）| int8_float16（混合）
WHISPER_COMPUTE_TYPE=int8
# 设备: cpu | cuda | auto
WHISPER_DEVICE=auto
# --- Qwen3-ASR-Flash 参数（备选，需阿里百炼 API Key）---
# DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ----------------------------------------------------------
# 4. 语雀文档拉取配置（DESIGN.md §3.2.1 语雀 PRD 文档拉取）
# 拉取工具：scripts/yuque_pull.py（基于 yuque_sync.py 引擎）
# Skill：.claude/skills/gy-meeting-yuque-pull/
# ----------------------------------------------------------
# 语雀知识库地址（默认，可在 CLI 参数中覆盖）
YUQUE_KNOWLEDGE_BASE_URL=https://your-team.yuque.com/namespace/repo
# 语雀 OpenAPI 只读 Token（推荐应用级 Token，限定只读 + 特定知识库）
YUQUE_API_TOKEN=your-yuque-api-token
YUQUE_API_BASE_URL=https://www.yuque.com/api/v2
# 语雀文档拉取超时（秒）
YUQUE_TIMEOUT_SECONDS=30
# 语雀 Session Cookie（下载附件用，选填。从浏览器 DevTools → Application → Cookies 获取）
YUQUE_SESSION=your-yuque-session-cookie
# 语雀 CToken Cookie（下载附件用，选填）
YUQUE_CTOKEN=your-yuque-ctoken

# ----------------------------------------------------------
# 5. 钉钉机器人推送配置（DESIGN.md §3.4 多渠道消息通知适配）
# 选填，不填则不推送
# ----------------------------------------------------------
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_WEBHOOK_SECRET=your-webhook-secret

# ----------------------------------------------------------
# 6. 数据库配置（DESIGN.md §7.1 部署方案）
# ----------------------------------------------------------
# 原型阶段使用 SQLite WAL 模式
DATABASE_URL=sqlite:///data/meeting.db
# 启用 WAL 模式（Write-Ahead Logging，提升并发性能）
SQLITE_WAL_MODE=true

# ----------------------------------------------------------
# 7. 文件存储路径（DESIGN.md §7.1 文件存储目录结构）
# ----------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
SNAPSHOT_DIR=./data/snapshots
OUTPUT_DIR=./data/outputs
TEMP_DIR=./data/temp

# ----------------------------------------------------------
# 8. 上传限制（DESIGN.md §7.2 + §9 风险应对）
# ----------------------------------------------------------
# 单位：MB
MAX_AUDIO_SIZE_MB=200
MAX_DOC_SIZE_MB=20
# 允许的音频格式
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a
# 允许的文档格式
ALLOWED_DOC_FORMATS=docx,pdf,txt,md

# ----------------------------------------------------------
# 9. 任务队列配置（DESIGN.md §3.6 异步任务队列）
# ----------------------------------------------------------
# 单任务超时（分钟），超过标记失败
TASK_TIMEOUT_MINUTES=30
# 同步处理阈值（分钟），音频 ≤ 此值可同步处理
SYNC_THRESHOLD_MINUTES=30
# 最大并发任务数
MAX_CONCURRENT_TASKS=1

# ----------------------------------------------------------
# 10. 安全配置（DESIGN.md §3.2.1 安全约束 + §7.2）
# ----------------------------------------------------------
# 加密密钥（用于加密存储语雀 Token 等敏感配置）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key
# 允许的 CORS 来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173